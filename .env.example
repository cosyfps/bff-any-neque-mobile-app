# Puerto HTTP del BFF
PORT=3000

# Entorno logico: development | production
NODE_ENV=development

# Version reportada por GET /health
APP_VERSION=0.1.0

# Origenes CORS permitidos, separados por coma.
# El WebView de Capacitor usa capacitor://localhost y http://localhost.
CORS_ORIGINS=capacitor://localhost,http://localhost,http://localhost:4200

# --- Supabase (NEQUEBFF-1.2 en adelante; no se usa todavia) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- JWT propio (NEQUEBFF-2.1 en adelante; no se usa todavia) ---
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
